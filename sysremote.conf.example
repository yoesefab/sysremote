# sysremote unified configuration example.

SSH_USER="${USER}"
SSH_PORT="22"
SSH_TIMEOUT="5"
INVENTORY_FILE=""
REQUIRE_ROOT="true"
REMOTE_SUDO="sudo -n"
DEFAULT_SESSION_COMMAND="who"
THREAD_JOBS="4"

LOG_DIR="./logs"
DEFAULT_BACKUP_DIR="./backups"
DEFAULT_RESTORE_DIR="./restore"
ARCHIVE_DIR="./archives"
REPORT_DIR="./reports"

SEUIL_ALERTE="80"
GENERER_HTML="true"
NOTIF_DISCORD="false"
DISCORD_WEBHOOK=""
NOTIF_EMAIL="false"
EMAIL_DESTINATAIRE=""
